{
  "rules": {
    ".read": false,
    ".write": false,
    "happyTravelers": {
      ".read": true,
      ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || newData.val() === data.val() + 1)"
    },
    "accountIds": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true",
        ".validate": "newData.val() === true"
      }
    },
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 32"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "country": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length <= 2"
        },
        "lastContactRequestAt": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isNumber()"
        },
        "orderCount": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "roles": {
          "loyal": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.val() === true && root.child('users').child($uid).child('orderCount').val() >= 10))",
            ".validate": "newData.isBoolean()"
          },
          "beta": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isBoolean()"
          },
          "bugfinder": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isBoolean()"
          },
          "helper": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isBoolean()"
          },
          "$other": { ".validate": false }
        },
        "newsletter": {
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.isBoolean()"
        },
        "consents": {
          "$doc": {
            ".validate": "($doc === 'terms' || $doc === 'privacy' || $doc === 'anpc') && newData.hasChildren(['v', 'at'])",
            "v": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "at": {
              ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
            },
            "off": {
              ".validate": "newData.isNumber() && newData.val() <= now + 86400000"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "orders": {
      ".read": false,
      "$orderId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['type', 'status', 'createdAt', 'name', 'phone', 'email'])",
        "type": {
          ".validate": "newData.val() === 'booking'"
        },
        "status": {
          ".validate": "newData.val() === 'nou'"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "dateText": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "uid": {
          ".validate": "auth != null && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 32"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().contains('@') && newData.val().length <= 120"
        },
        "destinationId": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "destinationTitle": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "price": {
          ".validate": "newData.isNumber()"
        },
        "currency": {
          ".validate": "newData.isString() && newData.val().length <= 6"
        },
        "travelers": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 22"
        },
        "travelDate": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "services": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "destination": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "adults": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
        },
        "children04": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
        },
        "children512": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
        },
        "totalPrice": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "pricePerPerson": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "priceDetails": {
          ".validate": "newData.isString() && newData.val().length <= 1500"
        },
        "amenitiesExcluded": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "returnDate": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "nights": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
        },
        "periodText": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "contactRequests": {
      ".read": false,
      "$reqId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['type', 'status', 'createdAt', 'name', 'phone', 'email'])",
        "type": {
          ".validate": "newData.val() === 'contact'"
        },
        "status": {
          ".validate": "newData.val() === 'nou'"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "dateText": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "uid": {
          ".validate": "auth != null && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 32"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().contains('@') && newData.val().length <= 120"
        },
        "destination": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "periodText": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "travelers": {
          ".validate": "newData.isString() && newData.val().length <= 150"
        },
        "services": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "amenitiesExcluded": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bugReports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$reportId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['text', 'status', 'createdAt', 'site'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 2000"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "site": {
          ".validate": "newData.val() === 'main' || newData.val() === 'reviews'"
        },
        "page": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "status": {
          ".validate": "newData.val() === 'nou'"
        },
        "createdAt": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "announcementTemplates": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$tplId": {
        ".validate": "newData.hasChildren(['title', 'text', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 80" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 1000" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    },
    "logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "at"
      ],
      "$logId": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['at', 'ts', 's', 'l', 'c', 'e'])",
        "at": {
          ".validate": "newData.val() === now"
        },
        "ts": {
          ".validate": "newData.isNumber() && newData.val() > 1700000000000 && newData.val() <= now + 86400000"
        },
        "s": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 12"
        },
        "l": {
          ".validate": "newData.val() === 'info' || newData.val() === 'warn' || newData.val() === 'error'"
        },
        "c": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "e": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 48"
        },
        "r": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
        },
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "d": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reviews": {
      "$destId": {
        ".read": true,
        "$reviewId": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))",
          ".validate": "newData.hasChildren(['uid','name','rating','createdAt']) && newData.child('uid').val() === auth.uid",
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 80"
          },
          "rating": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
          },
          "positive": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "negative": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "extra": {
            ".validate": "newData.isString() && newData.val().length <= 1200"
          },
          "lang": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "photos": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 350000 && newData.val().beginsWith('data:image/')"
            }
          }
        }
      }
    },
    "reviewStats": {
      "$destId": {
        ".read": true,
        ".write": "auth != null",
        "sum": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "count": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "reviewsFeed": {
      ".read": true,
      ".indexOn": [
        "rating",
        "createdAt"
      ],
      "$pushId": {
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)))",
        ".validate": "newData.hasChildren(['destId','destTitle','uid','name','rating','createdAt'])",
        "destId": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "destTitle": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "rating": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "positive": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "negative": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "extra": {
          ".validate": "newData.isString() && newData.val().length <= 1200"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "photos": {
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 350000 && newData.val().beginsWith('data:image/')"
          }
        }
      }
    }
  }
}